doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Update Cars
        a.home-link(href="/") Return to the homepage
        .form-wrapper
            form(method="post" action="/update-cobj")
                label(for="name") Name
                input(type="text" id="name" name="name" required)

                label(for="car_model") Car Model
                input(type="text" id="car_model" name="car_model" required)

                label(for="engine") Engine
                input(type="text" id="engine" name="engine" required)

                label(for="wheels") Wheels
                input(type="number" id="wheels" name="wheels" required)

                input(type="submit" value="Submit")
